# ==============================================================================
# DV CLOTHING — ENVIRONMENT VARIABLES SPECIFICATION (.env.example)
# ==============================================================================
# IMPORTANT: Never commit your actual .env file or real secrets to Git.
# Configure these in your Vercel Project Settings under "Environment Variables".
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL & OBJECT STORAGE (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Required for persistent product catalogues, orders, customer print uploads, and admin data.
# Where to find: Supabase Dashboard -> Project Settings -> API
# - SUPABASE_URL: Project URL (e.g., https://xyzcompany.supabase.co)
# - SUPABASE_SERVICE_ROLE_KEY: Secret Service Role Key (NEVER expose to browser / VITE_)
# - VITE_SUPABASE_ANON_KEY: Safe Public publishable key for client-side direct subscriptions (optional)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
VITE_SUPABASE_ANON_KEY=your_supabase_public_anon_key_here

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Required for accepting live UPI, Cards, NetBanking, and Wallets.
# Where to find: Razorpay Dashboard -> Settings -> API Keys (Test / Live Mode)
# If left empty, the website will build normally and honest notice will be shown:
# "Online payment setup pending — orders processed via Cash on Delivery."
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ------------------------------------------------------------------------------
# 3. ADMIN SECURITY & SESSION TOKENS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Used for HMAC cryptographic signing of admin session tokens & fallback portal credentials.
ADMIN_SESSION_SECRET=create_a_secure_random_64_character_string_here
ADMIN_USERNAME=admin@dvclothing.in
ADMIN_PASSWORD=your_secure_admin_password_here

# ------------------------------------------------------------------------------
# VERCEL DEPLOYMENT ENVIRONMENT SCOPES:
# - Production: Target 'Production' environment in Vercel settings.
# - Preview (PRs): Target 'Preview' environment (can use Supabase staging & Razorpay test keys).
# - Local Dev: Copy this file to '.env.local' and supply your credentials.
# Note: A new deployment is automatically required after changing Vercel environment variables.
# ==============================================================================
